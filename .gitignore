# ── Rust ─────────────────────────────────────────────────────────────────────
/target/
**/*.rs.bk
*.pdb

# Cargo.lock is committed for binaries (tracks exact dependency graph)
# Remove the line below if you want to stop tracking it.
# Cargo.lock

# ── Node / React (ui/) ───────────────────────────────────────────────────────
ui/node_modules/

# Built UI assets – regenerated by `make ui-build` / `npm run build`.
# The placeholder ui/dist/index.html IS tracked so `cargo build` works
# even before the UI has been compiled.
ui/dist/*
!ui/dist/index.html

# Vite / TS cache
ui/.vite/
ui/tsconfig.tsbuildinfo

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# config.toml is tracked as a template (default dev credentials).
# Copy to config.local.toml for production and add it here:
config.local.toml

# config.toml contains secrets (OpenAI API key etc.) – keep out of source control.
# Use config.example.toml as a starting template.
config.toml

# ── Editor / IDE ──────────────────────────────────────────────────────────────
# JetBrains (RustRover, IntelliJ, CLion …)
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code
.vscode/
*.code-workspace

# Vim / Emacs
*.swp
*.swo
*~
\#*\#

# ── OS ────────────────────────────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory

# ── Logs & temporaries ────────────────────────────────────────────────────────
*.log
logs/
*.tmp
*.bak