              "description": "Updated completion flag.",
              "example": true,
              "type": "boolean"
            },
            "title": {
              "description": "Updated task description.",
              "example": "Buy groceries and cook dinner",
              "type": "string"
            },
            "userId": {
              "description": "Reassign to a different user.",
              "example": 2,
              "type": "integer"
            }
          },
          "type": "object"
        }
      }
    },
    "info": {
      "contact": {
        "name": "JSONPlaceholder",
        "url": "https://jsonplaceholder.typicode.com"
      },
      "description": "A subset of the JSONPlaceholder fake REST API covering the **Todo** resource.\nJSONPlaceholder is a free online REST API that returns synthetic data, ideal\nfor prototyping and testing MCP tool integrations.\n\nAll write operations (POST, PUT, PATCH, DELETE) are accepted and return\nrealistic responses but **do not persist changes** — the data resets on\nevery request cycle.\n\n**Todo object fields:**\n| Field       | Type    | Description                                     |\n|-------------|---------|-------------------------------------------------|\n| `id`        | integer | Auto-assigned unique identifier (1–200)         |\n| `userId`    | integer | ID of the user this todo belongs to (1–10)      |\n| `title`     | string  | Short description of the task                   |\n| `completed` | boolean | Whether the task has been completed             |\n",
      "title": "JSONPlaceholder Todos API",
      "version": "1.0.0"
    },
    "openapi": "3.0.3",
    "paths": {
      "/todos": {
        "get": {
          "description": "Returns all 200 todos. Supports optional query-string filters to narrow\nresults by `userId` or `completed` status.\n",
          "operationId": "listTodos",
          "parameters": [
            {
              "description": "Filter todos that belong to a specific user (1–10).",
              "in": "query",
              "name": "userId",
              "required": false,
              "schema": {
                "example": 1,
                "maximum": 10,
                "minimum": 1,
                "type": "integer"
              }
            },
            {
              "description": "Filter by completion status (`true` or `false`).",
              "in": "query",
              "name": "completed",
              "required": false,
              "schema": {
                "example": false,
                "type": "boolean"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "example": [
                    {
                      "completed": false,
                      "id": 1,
                      "title": "delectus aut autem",
                      "userId": 1
                    },
                    {
                      "completed": false,
                      "id": 2,
                      "title": "quis ut nam facilis et officia qui",
                      "userId": 1
                    },
                    {
                      "completed": false,
                      "id": 3,
                      "title": "fugiat veniam minus",
                      "userId": 1
                    },
                    {
                      "completed": true,
                      "id": 4,
                      "title": "et porro tempora",
                      "userId": 1
                    },
                    {
                      "completed": false,
                      "id": 5,
                      "title": "laboriosam mollitia et enim quasi adipisci quia provident illum",
                      "userId": 1
                    }
                  ],
                  "schema": {
                    "items": {
                      "$ref": "#/components/schemas/Todo"
                    },
                    "type": "array"
                  }
                }
              },
              "description": "Array of Todo objects (possibly filtered)."
            }
          },
          "summary": "List all todos",
          "tags": [
            "Todos"
          ]
        },
        "post": {
          "description": "Creates a new Todo. JSONPlaceholder does not persist the record but\nreturns a synthetic response with `id: 201` to simulate a successful\ncreation.\n",
          "operationId": "createTodo",
          "requestBody": {
            "content": {
              "application/json": {
                "example": {
                  "completed": false,
                  "title": "Buy groceries",
                  "userId": 1
                },
                "schema": {
                  "$ref": "#/components/schemas/TodoInput"
                }
              }
            },
            "required": true
          },
          "responses": {
            "201": {
              "content": {
                "application/json": {
                  "example": {
                    "completed": false,
                    "id": 201,
                    "title": "Buy groceries",
                    "userId": 1
                  },
                  "schema": {
                    "$ref": "#/components/schemas/Todo"
                  }
                }
              },
              "description": "The newly created Todo (id is always 201 in the fake API)."
            }
          },
          "summary": "Create a new todo",
          "tags": [
            "Todos"
          ]
        }
      },
      "/todos/{id}": {
        "delete": {
          "description": "Deletes the Todo with the given `id`. Returns an empty object `{}` on\nsuccess. The deletion is simulated — no data is actually removed from\nJSONPlaceholder's store.\n",
          "operationId": "deleteTodo",
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "example": {},
                  "schema": {
                    "$ref": "#/components/schemas/Empty"
                  }
                }
              },
              "description": "Deletion acknowledged (empty body)."
            },
            "404": {
              "content": {
                "application/json": {
                  "example": {},
                  "schema": {
                    "$ref": "#/components/schemas/Empty"
                  }
                }
              },
              "description": "No todo found for the given ID."
            }
          },
          "summary": "Delete a todo",
          "tags": [
            "Todos"
          ]
        },
        "get": {
          "description": "Retrieves a single Todo by its `id`. Valid IDs are 1–200; any other\nvalue returns 404.\n",
          "operationId": "getTodo",
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "example": {
                    "completed": false,
                    "id": 1,
                    "title": "delectus aut autem",
                    "userId": 1
                  },
                  "schema": {
                    "$ref": "#/components/schemas/Todo"
                  }
                }
              },
              "description": "The requested Todo."
            },
            "404": {
              "content": {
                "application/json": {
                  "example": {},
                  "schema": {
                    "$ref": "#/components/schemas/Empty"
                  }
                }
              },
              "description": "No todo found for the given ID."
            }
          },
          "summary": "Get a todo by ID",
          "tags": [
            "Todos"
          ]
        },
        "parameters": [
          {
            "description": "Unique numeric identifier of the Todo (1–200).",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": 1,
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "patch": {
          "description": "Applies a partial update to the Todo identified by `id`. Only the fields\nincluded in the request body are changed; omitted fields retain their\ncurrent values. Useful for toggling `completed` without resending the\nfull object.\n",
          "operationId": "updateTodo",
          "requestBody": {
            "content": {
              "application/json": {
                "example": {
                  "completed": true
                },
                "schema": {
                  "$ref": "#/components/schemas/TodoPatch"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "example": {
                    "completed": true,
                    "id": 1,
                    "title": "delectus aut autem",
                    "userId": 1
                  },
                  "schema": {
                    "$ref": "#/components/schemas/Todo"
                  }
                }
              },
              "description": "The Todo after applying the partial update."
            },
            "404": {
              "content": {
                "application/json": {
                  "example": {},
                  "schema": {
                    "$ref": "#/components/schemas/Empty"
                  }
                }
              },
              "description": "No todo found for the given ID."
            }
          },
          "summary": "Partially update a todo",
          "tags": [
            "Todos"
          ]
        },
        "put": {
          "description": "Fully replaces the Todo identified by `id`. All writable fields must be\nprovided; omitted fields are treated as absent (not preserved).\nChanges are not persisted but the response mirrors what a real API\nwould return.\n",
          "operationId": "replaceTodo",
          "requestBody": {
            "content": {
              "application/json": {
                "example": {
                  "completed": true,
                  "title": "Buy groceries and cook dinner",
                  "userId": 1
                },
                "schema": {
                  "$ref": "#/components/schemas/TodoInput"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "example": {
                    "completed": true,
                    "id": 1,
                    "title": "Buy groceries and cook dinner",
                    "userId": 1
                  },
                  "schema": {
                    "$ref": "#/components/schemas/Todo"
                  }
                }
              },
              "description": "The updated Todo."
            },
            "404": {
              "content": {
                "application/json": {
                  "example": {},
                  "schema": {
                    "$ref": "#/components/schemas/Empty"
                  }
                }
              },
              "description": "No todo found for the given ID."
            }
          },
          "summary": "Replace a todo (full update)",
          "tags": [
            "Todos"
          ]
        }
      }
    },
