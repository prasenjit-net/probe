    "info": {
      "description": "A simple API for finding nearby ATMs by ZIP code or city name.\nDesigned as a test fixture for the MCP Gateway — the single search\nendpoint is richly documented so auto-generated MCP tools provide\nclear, useful descriptions for AI agents.\n\n## Usage\n\nQuery by **ZIP code** or **city** (or both). Results are ordered by\ndistance ascending. Each ATM record includes the machine's address,\nsupported networks, accessibility features, and current status.\n\n## Data model\n\nAn **ATM** has the following fields:\n\n| Field            | Type    | Notes                                           |\n|------------------|---------|-------------------------------------------------|\n| id               | string  | Unique machine identifier (e.g. \"ATM-00142\")    |\n| bank_name        | string  | Owning financial institution                    |\n| address          | object  | street, city, state, zip                        |\n| coordinates      | object  | latitude and longitude                          |\n| distance_miles   | number  | Distance from the queried location              |\n| networks         | array   | Supported networks (VISA, Mastercard, etc.)     |\n| accessibility    | object  | wheelchair, audio_guidance, braille_keypad      |\n| services         | array   | Cash withdrawal, deposits, coin exchange, etc.  |\n| fee_surcharge    | number  | Surcharge for non-customers (USD, 0 = free)     |\n| is_open_24h      | boolean | Whether the machine operates around the clock   |\n| hours            | string  | Operating hours if not 24/7                     |\n| status           | string  | \"online\" or \"offline\" or \"maintenance\"          |\n| last_updated     | string  | ISO 8601 timestamp of last status refresh       |\n",
      "title": "ATM Locator API",
      "version": "1.0.0"
    },
    "openapi": "3.0.3",
    "paths": {
      "/atms/search": {
        "get": {
          "description": "Returns a list of ATMs near the requested location, ordered by\ndistance ascending.\n\nAt least one of `zip` or `city` must be provided. When both are\ngiven, `zip` takes precedence for geocoding and `city` is used\nonly as a display hint.\n\n### Filtering\n\n- `radius_miles` — restrict results to within N miles (default 5, max 50)\n- `networks` — comma-separated list; only return ATMs that accept\n  at least one of the listed networks (e.g. `VISA,PLUS`)\n- `fee_free_only` — when `true`, exclude ATMs with a surcharge\n- `status` — filter by machine status (`online`, `offline`, `maintenance`)\n- `accessible_only` — when `true`, include only wheelchair-accessible machines\n\n### Pagination\n\nUse `limit` (default 20, max 100) and `offset` for paging.\n",
          "operationId": "searchATMs",
          "parameters": [
            {
              "description": "5-digit US ZIP code to use as the search centre.\nEither `zip` or `city` is required.\n",
              "in": "query",
              "name": "zip",
              "required": false,
              "schema": {
                "example": "10001",
                "pattern": "^\\d{5}$",
                "type": "string"
              }
            },
            {
              "description": "City name (optionally include state abbreviation separated by a\ncomma, e.g. \"Austin, TX\"). Used when no ZIP is provided.\nEither `zip` or `city` is required.\n",
              "in": "query",
              "name": "city",
              "required": false,
              "schema": {
                "example": "Austin, TX",
                "type": "string"
              }
            },
            {
              "description": "Search radius in miles. Must be between 0.1 and 50.",
              "example": 2.5,
              "in": "query",
              "name": "radius_miles",
              "required": false,
              "schema": {
                "default": 5,
                "format": "float",
                "maximum": 50,
                "minimum": 0.1,
                "type": "number"
              }
            },
            {
              "description": "Comma-separated list of card networks to filter by.\nAccepted values: VISA, MASTERCARD, AMEX, DISCOVER, PLUS, CIRRUS, STAR, NYCE.\n",
              "example": "VISA,PLUS",
              "in": "query",
              "name": "networks",
              "required": false,
              "schema": {
                "type": "string"
              }
            },
            {
              "description": "When true, only ATMs with zero surcharge are returned.",
              "in": "query",
              "name": "fee_free_only",
              "required": false,
              "schema": {
                "default": false,
                "type": "boolean"
              }
            },
            {
              "description": "When true, only wheelchair-accessible ATMs are returned.",
              "in": "query",
              "name": "accessible_only",
              "required": false,
              "schema": {
                "default": false,
                "type": "boolean"
              }
            },
            {
              "description": "Filter by machine status.",
              "example": "online",
              "in": "query",
              "name": "status",
              "required": false,
              "schema": {
                "enum": [
                  "online",
                  "offline",
                  "maintenance"
                ],
                "type": "string"
              }
            },
            {
              "description": "Maximum number of results to return (1–100).",
              "in": "query",
              "name": "limit",
              "required": false,
              "schema": {
                "default": 20,
                "maximum": 100,
                "minimum": 1,
                "type": "integer"
              }
            },
            {
              "description": "Number of results to skip for pagination.",
              "in": "query",
              "name": "offset",
              "required": false,
              "schema": {
                "default": 0,
                "minimum": 0,
                "type": "integer"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
